# Backend
PORT=4000
DATABASE_URL=postgresql://dev:dev@localhost:5432/ruach_db
JWT_SECRET=changeme
JWT_REFRESH_SECRET=changeme_refresh
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# S3 / LocalStack
S3_ENDPOINT=http://localhost:4566
S3_BUCKET=ruach-reports
S3_REGION=us-east-1
S3_ACCESS_KEY=local
S3_SECRET_KEY=local

# Google Play service account (base64)
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Play package & product
PLAY_PACKAGE_NAME=com.ruach.traderjournal
PLAY_SUBSCRIPTION_PRODUCT_ID=ruach_monthly
